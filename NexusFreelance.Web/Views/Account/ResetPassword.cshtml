@model NexusFreelance.Web.ViewModels.ResetPasswordForm
@{ ViewBag.Title = "Đặt lại mật khẩu"; }
<div class="auth-panel panel">
    <span class="eyebrow">ACCOUNT RECOVERY</span>
    <h1>Đặt lại mật khẩu</h1>
    @if (ViewBag.InvalidToken == true)
    {
        <p role="alert">Liên kết không hợp lệ, đã sử dụng hoặc hết hạn. Bạn có thể yêu cầu liên kết mới.</p>
        <a class="btn btn-primary" href="@Url.Action("ForgotPassword", "Account")">Yêu cầu liên kết mới</a>
    }
    else
    {
        using (Html.BeginForm("ResetPassword", "Account", FormMethod.Post))
        {
            @Html.AntiForgeryToken()
            @Html.HiddenFor(m => m.Token)
            @Html.ValidationSummary(false, "", new { @class = "error-list" })
            <label for="Password">Mật khẩu mới (tối thiểu 12 ký tự)</label>
            @Html.PasswordFor(m => m.Password, new { required = "required", minlength = "12", maxlength = "128", autocomplete = "new-password" })
            <label for="ConfirmPassword">Nhập lại mật khẩu mới</label>
            @Html.PasswordFor(m => m.ConfirmPassword, new { required = "required", minlength = "12", maxlength = "128", autocomplete = "new-password" })
            <button class="btn btn-primary full" type="submit">Lưu mật khẩu mới</button>
        }
    }
</div>
