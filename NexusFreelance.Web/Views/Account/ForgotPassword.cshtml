@model NexusFreelance.Web.ViewModels.ForgotPasswordForm
@{ ViewBag.Title = "Quên mật khẩu"; }
<div class="auth-panel panel">
    <span class="eyebrow">KHÔI PHỤC TÀI KHOẢN</span>
    <h1>Quên mật khẩu</h1>
    @Html.Partial("_MailDeliveryNotice")
    @if (ViewBag.RequestAccepted == true)
    {
        <div class="alert success" role="status" tabindex="-1" id="recovery-result">
            <strong>Đã tiếp nhận yêu cầu khôi phục</strong>
            <p>Nếu email khớp với hồ sơ của vai trò đã chọn, bạn sẽ nhận được liên kết đặt lại mật khẩu. Liên kết có hiệu lực 30 phút và chỉ dùng được một lần.</p>
        </div>
        <p>Kiểm tra Hộp thư đến và Thư rác. Nếu chưa thấy thư, kiểm tra lại email và vai trò. Email mẫu có đuôi .example.test không có hộp thư để nhận liên kết.</p>
        <p class="muted">Vì bảo mật, thông báo này không xác nhận email có tài khoản hay không. Nếu dịch vụ gửi thư gặp sự cố, vui lòng thử lại sau hoặc liên hệ quản trị.</p>
        <a class="btn btn-primary" href="@Url.Action("Login", "Account")">Về trang đăng nhập</a>
        <a class="btn btn-outline" href="@Url.Action("ForgotPassword", "Account")">Kiểm tra lại thông tin</a>
    }
    else
    {
        <p class="muted">Nhập email đã đăng ký để nhận liên kết đặt lại mật khẩu.</p>
        using (Html.BeginForm("ForgotPassword", "Account", FormMethod.Post, new { data_recovery_form = "true" }))
        {
            @Html.AntiForgeryToken()
            @Html.ValidationSummary(false, "", new { @class = "error-list", role = "alert" })
            <label for="Role">Vai trò cần khôi phục</label>
            @Html.DropDownListFor(m => m.Role, new[] { new SelectListItem { Value = "Client", Text = "Khách hàng / Client" }, new SelectListItem { Value = "Freelancer", Text = "Freelancer" }, new SelectListItem { Value = "Admin", Text = "Quản trị" } }, new { required = "required" })
    <label for="Email">Email</label>
            @Html.TextBoxFor(m => m.Email, new { type = "email", required = "required", maxlength = "200", autocomplete = "email", placeholder = "ten@gmail.com", aria_describedby = "recovery-help recovery-progress" })
            <p class="form-help" id="recovery-help">Cùng một email có thể có hồ sơ Client và Freelancer riêng. Chọn đúng vai trò để nhận liên kết cho hồ sơ cần đổi mật khẩu.</p>
            <p id="recovery-progress" class="alert" data-recovery-status role="status" aria-live="polite" hidden></p>
            <button class="btn btn-primary full" type="submit">Gửi liên kết đặt lại mật khẩu</button>
        }
    }
</div>
@section scripts { <script src="@Url.Content("~/Content/recovery-form.js")?v=20261017.11"></script> }
