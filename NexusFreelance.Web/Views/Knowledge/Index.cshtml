@model NexusFreelance.Web.ViewModels.KnowledgeLibraryPage
@{ViewBag.Title="Kho tri thức sau dự án";var role=(string)ViewBag.CurrentRole;}
<div class="page-head"><span class="eyebrow">KINH NGHIỆM CÓ THỂ TÁI SỬ DỤNG</span><h1>Kho tri thức sau dự án</h1><p>Bài học, cách làm và tiêu chí nghiệm thu do chủ dự án đã hoàn thành chủ động chia sẻ. Chọn nguồn này trong trợ lý JD để tham khảo cho dự án mới.</p></div>
<div class="toolbar">@if(role=="Client" || role=="Admin"){<a class="btn btn-primary" href="@Url.Action("Completed")">@(role=="Admin"?"Tra cứu dự án đã hoàn thành":"Dự án đã hoàn thành & tri thức của tôi")</a>}@if(role=="Client"){<a class="btn btn-outline" href="@Url.Action("New","JobStudio")">Soạn JD từ nhu cầu mới</a>}</div>
@using(Html.BeginForm("Index","Knowledge",FormMethod.Get,new{@class="form-grid panel"})) {<div><label for="knowledge-q">Tìm kinh nghiệm</label><input id="knowledge-q" name="q" value="@Model.Query" maxlength="100" placeholder="Đặt lịch, kiểm thử, thuật ngữ..."/></div><div><label for="knowledge-industry">Nhóm ngành</label><select id="knowledge-industry" name="industry"><option value="">Tất cả ngành</option>@foreach(var industry in NexusFreelance.Web.Services.IndustryCatalog.All){<option value="@industry" selected="@(industry==Model.Industry?"selected":null)">@industry</option>}</select></div><div class="form-actions"><button class="btn btn-primary" type="submit">Tìm tri thức</button><a class="btn btn-outline" href="@Url.Action("Index")">Xóa bộ lọc</a></div>}
<p class="form-help">@Model.Total bài học chung · Mỗi bài được soạn riêng để chia sẻ; tài liệu dự án gốc, hồ sơ, hội thoại và tệp riêng vẫn nằm trong phạm vi truy cập của chúng.</p>
@if(!Model.Items.Any()){<div class="empty"><strong>Chưa có bài học phù hợp</strong><p>Client có thể mở dự án đã hoàn thành và biên soạn kinh nghiệm chung để đóng góp.</p></div>}
<div class="knowledge-grid">@foreach(var item in Model.Items){<article class="panel knowledge-card"><div class="heading-row"><span class="pill">@item.Industry</span><span class="muted">Phiên bản @item.Version</span></div><h2><a href="@Url.Action("Details",new{id=item.Id})">@item.Title</a></h2><p>@item.Summary</p><p class="form-help">Kỹ năng: @item.SkillTags</p><time datetime="@item.CreatedAtUtc.ToString("yyyy-MM-ddTHH:mm:ssZ")">Chia sẻ @item.CreatedAtUtc.AddHours(7).ToString("dd/MM/yyyy HH:mm") · UTC+7</time><a class="btn btn-outline" href="@Url.Action("Details",new{id=item.Id})">Xem bài học &amp; tiêu chí</a></article>}</div>
@if(Model.Total>12){<nav class="pagination" aria-label="Trang tri thức">@if(Model.Page>1){<a href="@Url.Action("Index",new{q=Model.Query,industry=Model.Industry,page=Model.Page-1})">← Trước</a>}<span>Trang @Model.Page</span>@if(Model.Page*12<Model.Total){<a href="@Url.Action("Index",new{q=Model.Query,industry=Model.Industry,page=Model.Page+1})">Sau →</a>}</nav>}
