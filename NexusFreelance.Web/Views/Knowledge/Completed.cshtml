@model System.Collections.Generic.List<NexusFreelance.Web.ViewModels.CompletedKnowledgeProject>
@{ViewBag.Title="Dự án hoàn thành & tri thức";var page=(int)ViewBag.Page;var total=(int)ViewBag.Total;}
<div class="page-head"><span class="eyebrow">SAU NGHIỆM THU</span><h1>Dự án đã hoàn thành</h1><p>Kiểm tra kết quả, lưu bài học nội bộ và chọn nội dung chuyên môn có thể chia sẻ cho dự án mới.</p></div>
<div class="toolbar"><a class="btn btn-outline" href="@Url.Action("Index")">Kho tri thức dùng chung</a></div>
@if(!Model.Any()){<div class="empty">Chưa có dự án hoàn thành trong phạm vi tài khoản này.</div>}
@foreach(var p in Model){<article class="panel section-small"><div class="heading-row"><h2>@p.Title</h2><span class="pill">Đã hoàn thành</span></div><p>@p.Industry · @p.MemoryVersions phiên bản nội bộ · @(p.HasSharedArticle?"Đã có bài học chia sẻ":"Chưa chia sẻ tri thức")</p><div class="toolbar"><a class="btn btn-outline" href="@Url.Action("Index","Contracts",new{projectId=p.Id})">Hợp đồng &amp; kết quả</a>@if(p.IsOwner){<a class="btn btn-outline" href="@Url.Action("Index","ProjectMemory",new{projectId=p.Id})">Tri thức nội bộ</a><a class="btn btn-primary" href="@Url.Action("Share",new{projectId=p.Id})">@(p.HasSharedArticle?"Biên soạn phiên bản chia sẻ mới":"Chia sẻ kinh nghiệm chung")</a>}</div></article>}
@if(total>12){<nav class="pagination" aria-label="Trang dự án hoàn thành">@if(page>1){<a href="@Url.Action("Completed",new{page=page-1})">← Trước</a>}<span>Trang @page</span>@if(page*12<total){<a href="@Url.Action("Completed",new{page=page+1})">Sau →</a>}</nav>}
