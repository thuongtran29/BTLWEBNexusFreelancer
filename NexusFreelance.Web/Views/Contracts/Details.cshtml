@using System.Linq
@using NexusFreelance.Web.Services
@model NexusFreelance.Web.ViewModels.ContractDetailsPage
@{ ViewBag.Title="Hợp đồng #"+Model.Contract.Id;var c=Model.Contract;var v=Model.Version;var s=Model.Snapshot;var current=v.VersionNumber==c.CurrentVersion;var ready=c.Status=="AwaitingEscrow" || c.Status=="Active"; }
<div class="page-head"><div class="heading-row"><div><span class="eyebrow">HỢP ĐỒNG #@c.Id · PHIÊN BẢN @v.VersionNumber</span><h1>@s.ProjectTitle</h1></div><span class="pill">@ContractPresentation.Status(c.Status)</span></div><p>Client: @c.Project.Client.Name · Đại diện thực hiện: @c.Counterparty.Name</p></div>
@if ((string)ViewBag.CurrentRole == "Admin") { <div class="action-group"><a class="btn btn-outline" href="@Url.Action("UserProfile", "Admin", new { id=c.Project.ClientId })">Hồ sơ khách hàng</a><a class="btn btn-outline" href="@Url.Action("UserProfile", "Admin", new { id=c.CounterpartyId })">Hồ sơ đại diện thực hiện</a></div> }
@Html.Partial("_NextStep",Model)
<div class="contract-summary"><section class="panel"><small>Giá cố định</small><strong>@s.Price.ToString("N0") VND</strong></section><section class="panel"><small>Thời gian thực hiện</small><strong>@s.DeliveryDays ngày</strong><small>Tính từ khi mốc đầu được bảo đảm</small></section><section class="panel"><small>Phí nền tảng</small><strong>@((s.FeeRate*100).ToString("0.##"))%</strong><small>Trừ trên khoản giải ngân được hưởng</small></section></div>
@if(!current) { <p class="alert danger">Bạn đang xem bản cũ. <a href="@Url.Action("Details",new{id=c.Id})">Mở phiên bản hiện hành</a>. Bản này được giữ nguyên để tra cứu.</p> }
<section class="panel section-small"><h2>Phạm vi &amp; điều khoản</h2><p class="description">@s.Scope</p><p>@s.AcceptancePolicy</p><p>@s.ProductRights</p><details class="contract-proof"><summary>Mã kiểm tra nội dung và lịch sử phiên bản</summary><code>@v.Hash</code><p>Tạo lúc @v.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC. Xác nhận gắn với mã này; sửa điều khoản tạo phiên bản mới.</p>@foreach(var old in Model.Versions) { <a href="@Url.Action("Details",new{id=c.Id,version=old.VersionNumber})">Phiên bản @old.VersionNumber</a><span> · </span> }</details></section>
<section class="panel section-small" data-snapshot-plan="@v.VersionNumber"><h2>Mốc đã thống nhất · phiên bản @v.VersionNumber</h2><p>Ngày hạn tính từ thời điểm mốc đầu được ký quỹ. Đây là kế hoạch thuộc đúng phiên bản đang xem.</p>
@foreach(var planned in s.Milestones){<article class="signed-milestone"><h3>@planned.Title · @planned.Amount.ToString("N0") VND</h3><p class="muted">@(planned.DueDay.HasValue?"Hạn: ngày thứ "+planned.DueDay:"Theo thời gian thực hiện chung của phiên bản này")</p><p><strong>Tiêu chí nghiệm thu:</strong> @(string.IsNullOrWhiteSpace(planned.AcceptanceCriteria)?"Theo phạm vi và điều khoản của phiên bản này.":planned.AcceptanceCriteria)</p></article>}
</section>
<section class="panel section-small"><h2 id="contract-signatures">Đội hình &amp; xác nhận</h2><p>Client, đại diện và từng người trong đội hình phải xác nhận cùng phiên bản trước khi thanh toán.</p>
@foreach(var member in s.Members) { var accepted=Model.Acceptances.Any(a=>a.UserAccountId==member.UserId);<div class="list-item"><div><strong>@member.Name</strong><p>@member.Role · @((member.Weight/s.Price*100).ToString("0.##"))% sau phí</p></div><span class="pill">@(accepted?"Đã xác nhận":"Chờ xác nhận")</span></div> }
<div class="list-item"><strong>@c.Project.Client.Name · Client</strong><span class="pill">@(Model.Acceptances.Any(a=>a.UserAccountId==c.Project.ClientId)?"Đã xác nhận":"Chờ xác nhận")</span></div>
@foreach(var ack in Model.Acceptances) { <p class="muted">@ack.User.Name · @ack.AcceptedAtUtc.ToString("dd/MM/yyyy HH:mm:ss") UTC</p> }
@if(current && c.Status=="AwaitingSignatures" && !Model.HasConfirmed && !Model.IsAdmin) { using(Html.BeginForm("Confirm","Contracts",new{id=c.Id},FormMethod.Post,new{data_confirm="Xác nhận bạn đã đọc và đồng ý đúng phiên bản điều khoản này?"})) { @Html.AntiForgeryToken()<input type="hidden" name="versionId" value="@v.Id"/><input type="hidden" name="hash" value="@v.Hash"/><button type="submit" class="btn btn-primary">Tôi đồng ý phiên bản @v.VersionNumber</button> } }
@if(Model.HasConfirmed) { <p role="status" class="alert success">Bạn đã xác nhận phiên bản này. Các bản xác nhận trước vẫn được bảo toàn nếu có phiên bản mới.</p> }</section>
@if(current) { <section class="panel section-small"><div class="heading-row"><h2 id="contract-milestones">Mốc nghiệm thu &amp; bảo đảm</h2><a class="btn btn-outline" href="@Url.Action("Index","Workspace",new{id=Model.WorkspaceId})">Kênh làm việc hợp đồng →</a></div><p>Chỉ tiền của hợp đồng này được dùng cho các mốc dưới đây. VNPay xác nhận tiền vào; nghiệm thu mới ghi nhận phần được giải ngân. Rút về ngân hàng thực hiện theo yêu cầu đối soát.</p>
@foreach(var m in Model.Milestones) { <article class="list-item"><div><h3>#@m.Id · @m.Title</h3><p>@m.Amount.ToString("N0") VND · @ContractPresentation.Status(m.Status)</p></div>@if(Model.IsOwner && ready && m.Status=="Planned") { <div class="contract-actions">
@using(Html.BeginForm("Fund","Wallet",new{id=m.Id},FormMethod.Post,new{data_confirm="Giữ tiền từ ví cho đúng mốc của hợp đồng này?"})) { @Html.AntiForgeryToken()<button type="submit" class="btn btn-outline">Dùng số dư ví</button> }
@if(VnPaySettings.IsConfigured) { using(Html.BeginForm("Checkout","Payments",new{id=m.Id},FormMethod.Post,new{data_confirm="Tiếp tục sang cổng VNPay cho mốc này?"})) { @Html.AntiForgeryToken()<button type="submit" class="btn btn-primary">Thanh toán VNPay @(VnPaySettings.Mode=="sandbox"?"thử nghiệm":"")</button> } } else { <small>VNPay chưa được đơn vị vận hành cấu hình.</small> }</div> }</article> }
@if(!ready && c.Status=="AwaitingSignatures") { <p role="status">Cần đủ xác nhận trước khi bảo đảm mốc đầu.</p> }</section> }
@if(Model.CanRevise) { <section class="panel section-small"><details><summary>Đề nghị phiên bản điều khoản mới</summary><p>Giá tổng giữ theo chào giá được chọn. Thay phạm vi, hạn hoặc kế hoạch trước bảo đảm sẽ yêu cầu mọi bên xác nhận lại.</p>@using(Html.BeginForm("Revise","Contracts",new{id=c.Id},FormMethod.Post)) { @Html.AntiForgeryToken()<label for="contract-scope">Phạm vi</label><textarea id="contract-scope" name="scope" rows="6" minlength="20" maxlength="8000" required>@s.Scope</textarea><label for="contract-days">Số ngày</label><input id="contract-days" name="deliveryDays" type="number" min="1" max="3650" value="@s.DeliveryDays" required/>@Html.Partial("_MilestoneEditor",new NexusFreelance.Web.ViewModels.MilestoneEditor {Id="contract-plan",FieldName="milestonePlan",FixedTotal=s.Price,DeliverySelector="#contract-days",IsGroup=s.Members.Count>1,Plan=new System.Web.Script.Serialization.JavaScriptSerializer().Serialize(s.Milestones)})<button class="btn btn-outline" type="submit">Gửi phiên bản mới để xác nhận</button> }</details></section> }
@if(current && !Model.IsAdmin && (c.Status=="AwaitingSignatures" || c.Status=="AwaitingEscrow") && Model.Payments.Count==0) { <section class="panel section-small"><details><summary>Từ chối ký kết</summary>@using(Html.BeginForm("Decline","Contracts",new{id=c.Id},FormMethod.Post,new{data_confirm="Từ chối hợp đồng và trả lại các vị trí tuyển? Lịch sử vẫn được giữ."})) { @Html.AntiForgeryToken()<label for="decline-reason">Lý do</label><textarea id="decline-reason" name="reason" rows="2" minlength="10" maxlength="500" required></textarea><button type="submit" class="btn btn-outline">Từ chối hợp đồng</button> }</details></section> }
@if(current && !Model.IsAdmin && c.Status=="Active") { <section class="panel section-small"><details><summary>Yêu cầu xử lý tranh chấp</summary><p>Chỉ hợp đồng này tạm dừng; các hợp đồng khác của dự án vẫn làm việc bình thường.</p>@using(Html.BeginForm("Dispute","Wallet",new{id=c.ProjectId},FormMethod.Post,new{data_confirm="Tạm giữ phần tiền và công việc của hợp đồng này để quản trị xử lý?"})) { @Html.AntiForgeryToken()<input type="hidden" name="contractId" value="@c.Id"/><label for="dispute-reason">Mô tả và bằng chứng</label><textarea id="dispute-reason" name="reason" rows="4" minlength="15" maxlength="2000" required></textarea><button class="btn btn-outline" type="submit">Gửi tranh chấp hợp đồng</button> }</details></section> }
@foreach(var dispute in Model.Disputes) { <section class="panel section-small"><h3>Tranh chấp #@dispute.Id · @ContractPresentation.Status(dispute.Status)</h3><p>@dispute.Reason</p><p>@dispute.Resolution</p></section> }
@if(Model.Payments.Any()) { <section class="panel section-small"><h2>Giao dịch VNPay của hợp đồng</h2>@foreach(var p in Model.Payments) { <div class="list-item"><div><strong>@p.TxnRef · @ContractPresentation.Status(p.Status)</strong><p>@p.Amount.ToString("N0") VND · @p.Environment · @p.CreatedAtUtc.ToString("dd/MM/yyyy HH:mm") UTC</p></div>@if(Model.IsOwner || Model.IsAdmin) { using(Html.BeginForm("Reconcile","Payments",new{id=p.Id},FormMethod.Post)) { @Html.AntiForgeryToken()<button type="submit" class="btn btn-outline">Đối soát VNPay</button> } }</div> }<p class="muted">Trang chuyển về không tự cộng tiền. Giao dịch không rõ kết quả cần được đối soát với VNPay.</p></section> }
@Html.Partial("_Refunds",Model)
