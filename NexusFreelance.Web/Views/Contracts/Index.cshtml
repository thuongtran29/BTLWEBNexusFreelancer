@using NexusFreelance.Web.Services
@using NexusFreelance.Web.Models
@model System.Collections.Generic.List<ProjectContract>
@{ ViewBag.Title="Hợp đồng & bàn giao"; var versions=(System.Collections.Generic.Dictionary<int,ContractVersion>)ViewBag.Versions; var stage=(string)ViewBag.Stage??""; var isClient=(string)ViewBag.CurrentRole=="Client"; var isAdmin=(string)ViewBag.CurrentRole=="Admin"; }
<div class="page-head"><span class="eyebrow">HỢP TÁC CÓ XÁC NHẬN</span><h1>@(isAdmin?"Tra cứu hợp đồng":"Hợp đồng của tôi")</h1><p>@(isAdmin?"Tra cứu điều khoản, phiên bản xác nhận và dòng tiền của từng hợp đồng để đối chiếu khi có yêu cầu hỗ trợ.":"Mỗi chào giá được chọn có điều khoản, đội hình, mốc và dòng tiền riêng. Chọn hợp đồng để xem và xác nhận đúng phiên bản.")</p></div>
<nav class="workflow-tabs" aria-label="Lọc hợp đồng theo việc cần làm" data-contract-stage="@stage">@foreach(var item in ContractInbox.Stages) { <a href="@Url.Action("Index",new{projectId=ViewBag.ProjectId,stage=item.Key})" aria-current="@(stage==item.Key?"page":null)">@item.Value</a> }</nav>
<div class="page-explainer"><strong>Thứ tự thực hiện</strong><span>1. Đọc &amp; xác nhận điều khoản</span><span>2. Khách hàng ký quỹ</span><span>3. Làm việc &amp; nộp sản phẩm</span><span>4. Nghiệm thu &amp; giải ngân</span></div>
@if(Model.Count==0) { <section class="panel empty"><h2>@(stage==""?"Chưa có hợp đồng":"Chưa có hợp đồng trong nhóm này")</h2><p>@(stage==""?isAdmin?"Hợp đồng sẽ xuất hiện khi khách hàng chọn một đề xuất trong dự án.":isClient?"Chọn chào giá phù hợp trong dự án của bạn để tạo hợp đồng. Sau khi hai phía xác nhận, bạn bảo đảm tiền cho mốc đầu.":"Hợp đồng xuất hiện khi khách hàng chọn đề xuất của bạn. Hãy mở dự án phù hợp và gửi chào giá trước.":"Bạn có thể xem nhóm khác hoặc quay lại danh sách tất cả hợp đồng.")</p><a class="btn btn-outline" href="@(stage!=""?Url.Action("Index",new{projectId=ViewBag.ProjectId}):isAdmin?Url.Action("Index","Admin"):isClient?Url.Action("Mine","Projects"):Url.Action("Index","Home"))">@(stage!=""?"Xem tất cả hợp đồng":isAdmin?"Về trang quản trị":isClient?"Mở dự án của tôi":"Tìm dự án để ứng tuyển") →</a></section> }
@foreach(var c in Model) { var v=versions[c.Id]; <article class="panel contract-list-row"><div><span class="eyebrow">HỢP ĐỒNG #@c.Id · @ContractPresentation.Status(c.Status)</span><h2><a href="@Url.Action("Details",new{id=c.Id})">@c.Project.Title</a></h2><p>@c.Counterparty.Name · Phiên bản @c.CurrentVersion · @v.DeliveryDays ngày</p></div><div><strong class="contract-price">@v.Price.ToString("N0") <small>VND</small></strong><a class="btn btn-primary" href="@Url.Action("Details",new{id=c.Id})">Xem hợp đồng →</a></div></article> }
@if(Model.Count==100) { <p class="muted">Đang hiển thị 100 hợp đồng gần nhất. Mở từ trang dự án để xem theo dự án.</p> }
