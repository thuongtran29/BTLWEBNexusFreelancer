@model System.Collections.Generic.List<NexusFreelance.Web.ViewModels.PositionRecommendation>
@if(!Model.Any()){<p class="empty">Thêm vị trí tuyển dụng để xem ứng viên theo từng phần việc.</p>}
@foreach(var role in Model){<section class="position-match" data-role-match="@role.RoleId"><div class="heading-row"><h3>@role.Title</h3><span class="pill">Cần @role.RequiredCount · Còn @role.Remaining vị trí</span></div><div class="skill-chips">@foreach(var skill in role.Skills){<span class="pill">@skill.Skill.Title · từ @skill.MinimumLevel/5</span>}</div>@if(role.Skills.Count==0){<p class="form-help">Chưa đủ dữ liệu để đánh giá vị trí này. Làm rõ tên chuyên môn và kỹ năng trong yêu cầu trước khi tuyển.</p>}else if(role.Remaining==0){<p class="form-help">Vị trí đã đủ người; lịch sử tuyển và hợp đồng vẫn được giữ.</p>}else{@Html.Partial("~/Views/Shared/_MatchCards.cshtml",role.People)}</section>}
