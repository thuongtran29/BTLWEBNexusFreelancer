@model NexusFreelance.Web.Models.Project
@using NexusFreelance.Web.Models
@{ ViewBag.Title = "Ký quỹ dự án"; var owner = (bool)ViewBag.IsOwner; var milestones = (List<EscrowMilestone>)ViewBag.Milestones; var shares = (List<EscrowShare>)ViewBag.Shares; var totalWeight = shares.Sum(s => s.Weight); }
<div class="page-head"><span class="eyebrow">PROJECT FINANCE · #@Model.Id</span><h1>@Model.Title</h1><p>Giá hợp đồng @Model.Budget.ToString("N0") VND · Phí nền tảng @((Model.PlatformFeeRate * 100).ToString("0.##"))% · @Model.Status</p>
@if (ViewBag.WorkspaceId != null) { <a class="btn btn-outline" href="@Url.Action("Index", "Workspace", new { id = ViewBag.WorkspaceId })">Mở Workspace &amp; bàn giao →</a> }</div>
@if (Model.Status == "Disputed") { <div class="alert danger">Dự án đang tranh chấp. Ký quỹ và bàn giao tạm đóng băng cho đến khi quản trị quyết định.</div> }
<section class="panel section-small"><h2>Mốc thanh toán</h2><p>Phải ký quỹ trước khi làm việc. Bàn giao và duyệt được thực hiện trong Workspace. Khi Client xác nhận nghiệm thu, tiền được chia theo tỷ trọng đã chốt sau khi trừ phí. Sau 7 ngày chưa phản hồi, hệ thống nhắc Client và quản trị viên hỗ trợ; tiền vẫn được giữ cho đến khi có quyết định hợp lệ.</p>
@foreach (var m in milestones) { <div class="list-item"><div><h3>#@m.Id · @m.Title</h3><p>@m.Amount.ToString("N0") VND · @m.Status</p>@if (m.SettledAtUtc.HasValue) { <p>Phí: @m.Fee.ToString("N0") · Hoàn: @m.Refunded.ToString("N0") VND</p> }</div>
@if (owner && m.Status == "Planned" && (Model.Status == "AwaitingEscrow" || Model.Status == "InProgress")) { using (Html.BeginForm("Fund", "Wallet", new { id = m.Id }, FormMethod.Post, new { data_confirm = "Giữ " + m.Amount.ToString("N0") + " VND từ ví cho mốc này?" })) { @Html.AntiForgeryToken()<button type="submit" class="btn btn-primary">Ký quỹ mốc</button> } }</div> }
</section>
@if (owner && Model.Status == "AwaitingEscrow") { <section class="panel section-small"><h2>Chia mốc trước khi ký quỹ</h2><p>Mỗi dòng: Tiêu đề | Số tiền VND. Tổng phải bằng @Model.Budget.ToString("N0") VND. Sau khi có ký quỹ, kế hoạch được khóa.</p>
@using (Html.BeginForm("Plan", "Wallet", new { id = Model.Id }, FormMethod.Post)) { @Html.AntiForgeryToken()<label for="lines">Kế hoạch mốc</label><textarea id="lines" name="lines" rows="5" maxlength="4000" required>@string.Join("\n", milestones.Select(m => m.Title + " | " + m.Amount.ToString("0", System.Globalization.CultureInfo.InvariantCulture)))</textarea><button type="submit" class="btn btn-outline">Lưu kế hoạch</button> }</section> }
@if (Model.Status == "Completed" && (string)ViewBag.CurrentRole == "Freelancer") { <section class="panel section-small"><h2>Đánh giá khách hàng</h2>@using (Html.BeginForm("Review", "ClientProfile", FormMethod.Post)) { @Html.AntiForgeryToken()<input type="hidden" name="projectId" value="@Model.Id" /><label for="rating">Điểm đánh giá (1–5)</label><input id="rating" name="rating" type="number" min="1" max="5" required /><label for="comment">Nhận xét về giao tiếp, yêu cầu và thanh toán</label><textarea id="comment" name="comment" rows="3" maxlength="1000" required></textarea><button class="btn btn-primary" type="submit">Gửi đánh giá</button> }</section> }
<section class="panel section-small"><h2>Phân chia đã chốt</h2>@foreach (var s in shares) { <div class="list-item"><strong>@s.User.Name</strong><span>@((totalWeight > 0 ? s.Weight / totalWeight * 100 : 0).ToString("0.##"))% sau phí</span></div> }<p class="muted">Tỷ trọng dựa trên giá các chào giá đã chấp nhận; thay đổi thành viên nhóm sau này không ảnh hưởng hợp đồng này. Thành viên cuối nhận phần dư làm tròn VND.</p></section>
@if (Model.Status == "InProgress" && (string)ViewBag.CurrentRole != "Admin") { <section class="panel section-small"><h2>Khiếu nại giao dịch</h2>@using (Html.BeginForm("Dispute", "Wallet", new { id = Model.Id }, FormMethod.Post, new { data_confirm = "Gửi khiếu nại sẽ đóng băng dự án. Tiếp tục?" })) { @Html.AntiForgeryToken()<label for="reason">Mô tả vấn đề và bằng chứng (15–2000 ký tự)</label><textarea id="reason" name="reason" rows="4" minlength="15" maxlength="2000" required></textarea><button class="btn btn-outline" type="submit">Gửi quản trị xử lý</button> }</section> }
@foreach (var d in (List<EscrowDispute>)ViewBag.Disputes) { <section class="panel section-small"><h3>Khiếu nại #@d.Id · @d.Status</h3><p>@d.Reason</p><p>@d.Resolution</p></section> }
