<Project ToolsVersion="Current" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <OutputPath>_offline\bin\</OutputPath>
    <AssemblyName>NexusFreelance.OfflineCheck</AssemblyName>
    <RootNamespace>NexusFreelance.Web</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Xml" />
    <Reference Include="System"/><Reference Include="System.Core"/>
    <Reference Include="System.Web"/><Reference Include="System.Web.Extensions"/>
    <Reference Include="System.Web.Routing"/><Reference Include="System.Data"/>
    <Reference Include="System.Net.Http"/><Reference Include="System.Security"/>
    <Reference Include="System.Drawing"/>
    <Reference Include="System.Web.Helpers"><HintPath>$(ProjectBin)\System.Web.Helpers.dll</HintPath></Reference>
    <Reference Include="System.Web.WebPages"><HintPath>$(ProjectBin)\System.Web.WebPages.dll</HintPath></Reference>
    <Reference Include="System.Configuration"/><Reference Include="System.ComponentModel.DataAnnotations"/>
    <Reference Include="Microsoft.CSharp"/>
    <Reference Include="EntityFramework"><HintPath>$(ProjectBin)\EntityFramework.dll</HintPath></Reference>
    <Reference Include="System.Web.Mvc"><HintPath>$(ProjectBin)\System.Web.Mvc.dll</HintPath></Reference>
    <Compile Include="..\NexusFreelance.Web\**\*.cs" Exclude="..\NexusFreelance.Web\obj\**\*;..\NexusFreelance.Web\bin\**\*" />
  </ItemGroup>
  <Import Project="$(MSBuildBinPath)\Microsoft.CSharp.targets"/>
</Project>
